 // Signal-related
@@ -213,3 +220,21 @@ public class GodotSerializationInfo
     public void AddProperty(string name, Variant value) { }
     public bool TryGetProperty(string name, out Variant value) { value = default; return false; }
 }
+
+// The idle-time queue Godot flushes once per frame. Headless there are no frames: the host drains it whenever it
+// waits on the game (research/combat_parity/Substrate WaitFor).
+public static class DeferredCalls
+{
+    private static readonly Queue<Action> _pending = new();
+    public static void Enqueue(Action call) { lock (_pending) _pending.Enqueue(call); }
+    public static int Flush()
+    {
+        int n = 0;
+        while (true)
+        {
+            Action? next;
+            lock (_pending) { if (!_pending.TryDequeue(out next)) return n; }
+            next(); n++;
+        }
+    }
+}
